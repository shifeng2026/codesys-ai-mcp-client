{
  "id": "codesys-monitor",
  "name": "CODESYS",
  "version": "1.1.0",
  "entry": "builtin",
  "permissions": [
    "process.spawn.codesys-scriptengine"
  ],
  "capabilities": [
    "codesys.window.read",
    "codesys.scriptengine.offline",
    "codesys.online.authorized"
  ],
  "scriptEngine": {
    "mode": "offline-allowlist",
    "allowedActions": [
      "doctor",
      "probe",
      "capabilities",
      "bind-project",
      "inspect-project",
      "update-text",
      "build",
      "rebuild",
      "diff",
      "rollback",
      "build-status"
    ],
    "arbitraryScript": false,
    "onlineActions": {
      "enabled": true,
      "requiresWorkbenchAuthorization": true,
      "grantable": [
        "login",
        "logout",
        "download",
        "online-change",
        "write-variable",
        "start",
        "stop",
        "reset",
        "force"
      ],
      "hardGated": [
        "write-variable",
        "reset",
        "force"
      ],
      "unsupported": [
        "debug",
        "breakpoint",
        "step"
      ]
    }
  },
  "description": "CODESYS 原生窗口托管（枚举 + 把真实 HWND 放进插件区域）与受限 ScriptEngine 离线自动化，以及需工作台显式授权的在线登录/断开/下载"
}
