# Copy this block into %USERPROFILE%\.codex\config.toml, or run scripts\install-local.ps1.

[mcp_servers.codesys]
command = "C:\\Program Files\\nodejs\\node.exe"
args = ["C:\\Users\\YOUR_USER\\AppData\\Local\\codesys-codex-mcp\\server\\index.js"]
startup_timeout_sec = 30
tool_timeout_sec = 300

[mcp_servers.codesys.env]
CODESYS_MCP_ROOT = "C:\\Users\\YOUR_USER\\AppData\\Local\\codesys-codex-mcp"
CODESYS_MCP_ALLOW_ARBITRARY_SCRIPT = "0"
CODESYS_EXE = "C:\\Program Files\\CODESYS 3.5.21.0\\CODESYS\\Common\\CODESYS.exe"
CODESYS_PROFILE = "CODESYS V3.5 SP21"
